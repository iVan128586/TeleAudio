{
    "manifest_version": 3,
    "name": "TeleAudio",
    "version": "0.0",
    "content_scripts": [
        {
            "matches": ["https://telemost.yandex.ru/*"],
            "js": ["teleau.js"],
            "css": ["teleau.css"],
            "run_at": "document_end",
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["assets/*"],
            "matches": ["https://telemost.yandex.ru/*"]
        }
    ]
}